# Image release to run: latest, or a release tag like 0.2.0.
DATABASIFY_VERSION=latest

# The address people open in the browser. Use https:// with SERVER_NAME set to the same host for automatic HTTPS.
APP_URL=http://localhost
# Caddy site address: ":80" for plain HTTP (behind your own proxy), or a domain like "databasify.example.com" for automatic Let's Encrypt HTTPS.
SERVER_NAME=:80
# "tls internal" when Cloudflare proxies the domain (set Cloudflare SSL to Full); empty for automatic Let's Encrypt.
CADDY_TLS=
HTTP_PORT=80
HTTPS_PORT=443

APP_NAME=Databasify
APP_TIMEZONE=UTC

# Generated on first start and kept in the storage volume (storage/databasify.env) when left empty.
APP_KEY=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="databasify@example.com"
MAIL_FROM_NAME="${APP_NAME}"
